{
  "name": "simple-tab",
  "version": "5.5.0",
  "description": "极简导航 - 快速访问 (Chrome 新标签页扩展)",
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .js,.html",
    "lint:fix": "eslint . --ext .js,.html --fix",
    "format": "prettier --write \"**/*.{js,html,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,html,css,json,md}\"",
    "test": "vitest run",
    "dev": "echo 'Open chrome://extensions/ and load this folder in developer mode'"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-html": "^8.1.1",
    "prettier": "^3.3.3",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "chrome-extension",
    "new-tab",
    "minimalist"
  ],
  "license": "MIT"
}
